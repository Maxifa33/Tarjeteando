# URL del backend (sin /api/v1 al final)
# En desarrollo: http://localhost:3000/api/v1
# En producción: https://tu-app.railway.app/api/v1
VITE_API_URL=http://localhost:3000/api/v1

# Módulos (Supabase). Sin estas dos variables los módulos quedan desactivados y Tarjeteando funciona igual.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
